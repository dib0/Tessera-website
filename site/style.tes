// The stylesheet of the site, served at /assets/site.css. Pure text: the colours are the five tile colours of the Tessera logo.

note "The page CSS is part of the program, not of the database, so it always matches the HTML the program produces."
pub fn css() -> Text {
join([
":root{--bg:#f6f7fc;--fg:#10152b;--muted:#515b78;--card:#ffffff;--line:#dde2f1;--accent:#1745b8;--accent-fg:#ffffff;--lapis:#4c7dff;--teal:#00a3a8;--amber:#e0953a;--sky:#3aa6f5;--violet:#7c66f0;--code-bg:#0f1530;--code-fg:#e6eaff;--radius:14px;color-scheme:light dark}",
"@media (prefers-color-scheme:dark){:root{--bg:#0a0f1f;--fg:#e8ecfb;--muted:#9ba6c8;--card:#121a33;--line:#243056;--accent:#7aa2ff;--accent-fg:#0a0f1f;--code-bg:#060a16;--code-fg:#e6eaff}}",
"*{box-sizing:border-box}",
"html{-webkit-text-size-adjust:100%}",
"body{margin:0;background:var(--bg);color:var(--fg);font:17px/1.65 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}",
"a{color:var(--accent)}",
"a:focus-visible,.btn:focus-visible{outline:3px solid var(--lapis);outline-offset:2px;border-radius:6px}",
"img,svg{max-width:100%}",
".wrap{width:min(1120px,100% - 40px);margin-inline:auto}",
".narrow{width:min(760px,100% - 40px)}",
".skip{position:absolute;left:-999px;top:8px;background:var(--card);padding:8px 12px;border-radius:8px;z-index:10}",
".skip:focus{left:8px}",
"header.site{border-bottom:1px solid var(--line);background:var(--card)}",
".bar{display:flex;align-items:center;justify-content:space-between;gap:12px 28px;flex-wrap:wrap;padding:12px 0}",
".brand{display:flex;align-items:center;gap:12px;font-weight:700;font-size:1.25rem;letter-spacing:.02em;color:var(--fg);text-decoration:none}",
"nav{display:flex;flex-wrap:wrap;gap:4px 6px}",
"nav a{color:var(--muted);text-decoration:none;padding:6px 12px;border-radius:999px;font-size:.95rem}",
"nav a:hover{color:var(--fg);background:var(--bg)}",
"nav a[aria-current=page]{color:var(--accent-fg);background:var(--accent)}",
"nav a.gh{border:1px solid var(--line)}",
"h1,h2,h3{line-height:1.2;margin:0 0 .5em}",
"h1{font-size:clamp(2rem,5vw,3.4rem);letter-spacing:-.02em}",
"h2{font-size:clamp(1.5rem,3vw,2rem)}",
"h3{font-size:1.15rem}",
"p{margin:0 0 1em}",
"code{font:.92em ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--line);padding:.1em .35em;border-radius:6px}",
".hero{padding:64px 0 48px;background:radial-gradient(circle at 85% 10%,rgba(76,125,255,.20),transparent 45%),radial-gradient(circle at 10% 90%,rgba(80,229,208,.16),transparent 40%)}",
".hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:40px;align-items:center}",
".lead{font-size:1.2rem;color:var(--muted);max-width:44em}",
".actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}",
".btn{display:inline-block;padding:11px 20px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--fg);text-decoration:none;font-weight:600}",
".btn:hover{border-color:var(--accent)}",
".btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}",
".tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:min(280px,70vw);justify-self:center}",
".tiles i{display:block;aspect-ratio:1;border-radius:16%;box-shadow:0 6px 14px rgba(16,21,43,.18)}",
".tiles i:nth-child(1){background:linear-gradient(135deg,#4c7dff,#1745b8)}",
".tiles i:nth-child(2){background:linear-gradient(135deg,#50e5d0,#008c91)}",
".tiles i:nth-child(3){background:linear-gradient(135deg,#ffe39a,#d98b32)}",
".tiles i:nth-child(4){grid-column:2;background:linear-gradient(135deg,#71c9ff,#3263d9)}",
".tiles i:nth-child(5){grid-column:2;background:linear-gradient(135deg,#8a75ff,#197d9a)}",
".banner{padding:48px 0 12px}",
".banner p{max-width:44em}",
".block{padding:28px 0}",
".intro{color:var(--muted);max-width:46em}",
".cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:20px}",
".card{background:var(--card);border:1px solid var(--line);border-top:5px solid var(--c,var(--lapis));border-radius:var(--radius);padding:20px 22px}",
".card p{color:var(--muted);margin-bottom:.6em}",
".card .more{margin:0}",
".t1{--c:var(--lapis)}.t2{--c:var(--teal)}.t3{--c:var(--amber)}.t4{--c:var(--sky)}.t5{--c:var(--violet)}",
".steps{list-style:none;counter-reset:step;padding:0;margin:20px 0 0;display:grid;gap:14px}",
".steps li{counter-increment:step;display:grid;grid-template-columns:44px 1fr;gap:4px 16px;align-items:start}",
".steps li::before{content:counter(step);grid-row:span 2;display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--accent);color:var(--accent-fg);font-weight:700}",
".steps h3{margin:0}",
".steps p{margin:0;color:var(--muted)}",
".ticks{list-style:none;padding:0;margin:0 0 1em}",
".ticks li{padding-left:28px;position:relative;margin:.35em 0}",
".ticks li::before{content:'';position:absolute;left:4px;top:.6em;width:10px;height:10px;border-radius:3px;background:var(--teal)}",
"figure.code{margin:20px 0}",
"figure.code figcaption{font:600 .85rem ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted);margin-bottom:6px}",
"pre{margin:0;background:var(--code-bg);color:var(--code-fg);padding:18px 20px;border-radius:12px;overflow:auto;font:14px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;tab-size:4}",
"pre code{background:none;padding:0;font:inherit}",
".callout{border:1px solid var(--line);border-left:6px solid var(--amber);background:var(--card);border-radius:12px;padding:16px 20px}",
".callout strong{display:block;margin-bottom:4px}",
".callout p:last-child{margin:0}",
".cta{margin-top:24px;padding:48px 0;background:linear-gradient(135deg,rgba(76,125,255,.16),rgba(80,229,208,.14))}",
"footer.site{margin-top:48px;border-top:1px solid var(--line);padding:28px 0 40px;color:var(--muted);font-size:.92rem}",
"footer.site p{margin:0 0 .6em}",
".stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin:20px 0}",
".stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px 18px}",
".stat b{display:block;font-size:1.9rem;line-height:1.2}",
".stat span{color:var(--muted);font-size:.9rem}",
".grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:22px}",
"table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;font-size:.95rem}",
"th,td{text-align:left;padding:8px 12px;border-bottom:1px solid var(--line)}",
"td.n,th.n{text-align:right;font-variant-numeric:tabular-nums}",
"tr:last-child td{border-bottom:0}",
".chart{width:100%;height:auto;background:var(--card);border:1px solid var(--line);border-radius:12px}",
".chart .bar-rect{fill:var(--lapis)}",
".chart .axis{stroke:var(--line)}",
".chart text{fill:var(--muted);font-size:11px;text-anchor:middle}",
".muted{color:var(--muted)}",
"@media (max-width:820px){.hero-grid{grid-template-columns:1fr}.tiles{width:140px;justify-self:start}.hero{padding-top:40px}}"
], "\n")
}
