// The website of the Tessera language, written in Tessera.
//
// A web application is a program with `handle` instead of `main`. It runs inside nginx (through the Tessera
// module), as a built-in HTTP server (`serve`), as CGI or FastCGI. All texts and the page structure come from
// SQLite (see store.tes); on an empty database they are seeded from content.tes.

import std/http
import model uses nothing
import store uses db, env, random
import view uses nothing
import tracking uses nothing
import admin uses db, env, log, random, time
import manage uses db, env, random
import totp uses nothing
import qr uses nothing
import auth uses db, env, random

fn slug_of(path: Text) -> Text {
if path == "/" {
return "home"
}
var trimmed = path
if starts_with(trimmed, "/") {
set trimmed = slice_text(trimmed, 1, length(trimmed))
}
if ends_with(trimmed, "/") {
set trimmed = slice_text(trimmed, 0, length(trimmed) - 1)
}
trimmed
}

note "Counts one page view. See tracking.tes for what is, and is not, remembered."
fn remember(connection: Database, site: Map[Text, Text], request: http.Request, status: Int) -> Unit uses db, time {
if request.method == "GET" {
let moment = now()
let agent = value_or(http.header(request, "user-agent"), "")
let forwarded = value_or(http.header(request, "x-forwarded-for"), "")
let address = tracking.first_address(forwarded, request.remote_address)
let own_host = to_lower(value_or(http.header(request, "host"), ""))
let from_host = tracking.referrer_host(value_or(http.header(request, "referer"), ""))
let referrer = if from_host == own_host { "" } else { from_host }
let visitor = tracking.visitor_id(value_or(get(site, "stats_salt"), ""), tracking.day_of(moment), address, agent)
store.record_hit(connection, moment, tracking.clip(request.path, 120), status, visitor, referrer, tracking.agent_family(agent), tracking.is_bot(agent))
}
}

fn page_response(connection: Database, site: Map[Text, Text], request: http.Request, slug: Text) -> http.Response uses db, time {
let found = store.site_pages(connection, slug)
let current = found.page else return missing(connection, site, request)
if current.slug == "404" {
return missing(connection, site, request)
}
remember(connection, site, request, 200)
http.html(200, view.document(site, found.navigation, current, store.page_blocks(connection, current.slug)))
}

fn missing(connection: Database, site: Map[Text, Text], request: http.Request) -> http.Response uses db, time {
remember(connection, site, request, 404)
let found = store.site_pages(connection, "404")
let current = found.page else return http.text(404, "page not found\n")
http.html(404, view.document(site, found.navigation, current, store.page_blocks(connection, "404")))
}

fn unavailable() -> http.Response = http.text(503, "the site database is unavailable\n")

note "Where this site is, as a language model should write it down: taken from the host the request came in on, over https unless it is a local address. Empty when there is no host header, and then the index links relative to the site root."
fn origin_of(request: http.Request) -> Text {
let host = value_or(http.header(request, "host"), "")
if host == "" {
return ""
}
let forwarded = to_lower(value_or(http.header(request, "x-forwarded-proto"), ""))
let local = starts_with(host, "localhost") or starts_with(host, "127.0.0.1") or starts_with(host, "[::1]")
let scheme = if forwarded != "" { forwarded } else if local { "http" } else { "https" }
"\(scheme)://\(host)"
}

note "The index at /llms.txt, built from the pages in the database. /llms-full.txt is the language reference itself and is served next to it as a static file."
fn llms_response(connection: Database, site: Map[Text, Text], request: http.Request) -> http.Response uses db, time {
remember(connection, site, request, 200)
http.text(200, view.llms_index(site, store.listed_pages(connection), origin_of(request)))
}

fn handle(request: http.Request) -> http.Response uses db, env, log, random, time {
let path = request.path
if path == "/healthz" {
return http.text(200, "ok\n")
}
if path == "/admin" or starts_with(path, "/admin/") {
return admin.respond(request)
}
if request.method != "GET" and request.method != "HEAD" {
return http.with_header(http.text(405, "method not allowed\n"), "allow", "GET, HEAD")
}
if path == "/robots.txt" {
return http.text(200, "User-agent: *\nDisallow: /admin\n")
}
if path == "/llms.txt" {
let connection = store.open() else return unavailable()
return llms_response(connection, store.load_settings(connection), request)
}
let slug = slug_of(path)
if slug == "home" and path != "/" {
return http.redirect("/")
}
let connection = store.open() else return unavailable()
page_response(connection, store.load_settings(connection), request, slug)
}

// ---------- tests: `tessera1 test site/main.tes` ----------

test "the health check answers without a database" {
let answer = handle(http.request("GET", "/healthz", ""))
assert(answer.status == 200)
}

test "only GET and HEAD are allowed" {
let answer = handle(http.request("POST", "/", ""))
assert(answer.status == 405)
}

test "paths map to page slugs" {
assert(slug_of("/") == "home")
assert(slug_of("/why") == "why")
assert(slug_of("/why/") == "why")
}

test "a page is built from its blocks and everything from the database is escaped" {
let details = model.Page { slug: "demo", title: "<b>Demo</b>", description: "a \"demo\"", nav_label: "Demo", nav_order: 1, published: true }
let items = [model.Block { id: 0, kind: "section", heading: "A <i>heading</i>", body: "<script>alert(1)</script> and `code` and [a link](https://example.org/a?b=1&c=2)", extra: "" }]
let output = view.document(["site_name": "Tessera"], [details], details, items)
assert(not contains(output, "<script>"))
assert(not contains(output, "<b>Demo"))
assert(contains(output, "&lt;script&gt;"))
assert(contains(output, "<code>code</code>"))
assert(contains(output, "<a href='https://example.org/a?b=1&amp;c=2' rel='noopener'>a link</a>"))
assert(contains(output, "aria-current='page'"))
}

test "links to other schemes stay plain text" {
let details = model.Page { slug: "demo", title: "Demo", description: "", nav_label: "Demo", nav_order: 1, published: true }
let items = [model.Block { id: 0, kind: "section", heading: "", body: "[click](javascript:alert(1))", extra: "" }]
let output = view.document([:], [], details, items)
assert(not contains(output, "href='javascript"))
}

test "a visitor id is stable for a day and changes the next day" {
let today = tracking.visitor_id("salt", "2026-11-09", "203.0.113.7", "Firefox")
assert(today == tracking.visitor_id("salt", "2026-11-09", "203.0.113.7", "Firefox"))
assert(today != tracking.visitor_id("salt", "2026-11-10", "203.0.113.7", "Firefox"))
assert(length(today) == 16)
assert(not contains(today, "203.0.113.7"))
}

test "crawlers and tools are told apart from browsers" {
assert(tracking.is_bot("Googlebot/2.1"))
assert(tracking.is_bot(""))
assert(not tracking.is_bot("Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"))
assert(tracking.agent_family("Mozilla/5.0 (Windows NT 10.0) AppleWebKit/537.36 Chrome/130.0 Safari/537.36 Edg/130.0") == "Edge")
assert(tracking.agent_family("Mozilla/5.0 (Windows NT 10.0) AppleWebKit/537.36 Chrome/130.0 Safari/537.36") == "Chrome")
}

test "only the host of a referrer is kept" {
assert(tracking.referrer_host("https://News.Example.org/some/path?q=1") == "news.example.org")
assert(tracking.referrer_host("not a url") == "")
}

test "days are counted back from a moment" {
assert(tracking.day_of(0) == "1970-01-01")
assert(tracking.days_before(86400000 * 10, 3) == "1970-01-08")
}

test "SHA-1 and HMAC-SHA-1 match RFC 3174 and RFC 2202" {
assert(hex_encode(totp.sha1(to_bytes("abc"))) == "a9993e364706816aba3e25717850c26c9cd0d89d")
assert(hex_encode(totp.sha1(to_bytes(""))) == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
assert(hex_encode(totp.sha1(to_bytes(repeat("a", 1000)))) == "291e9a6c66994949b57ba5e650361e98fc36b1ba")
assert(hex_encode(totp.hmac_sha1(to_bytes("Jefe"), to_bytes("what do ya want for nothing?"))) == "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
}

test "one-time codes match RFC 4226 and RFC 6238" {
let secret = to_bytes("12345678901234567890")
assert(map([0, 1, 9], hotp_of_rfc_secret) == ["755224", "287082", "520489"])
assert(totp.hotp(secret, totp.step_of(59000)) == "287082")
assert(totp.hotp(secret, totp.step_of(1111111109000)) == "081804")
assert(totp.hotp(secret, totp.step_of(20000000000000)) == "353130")
}

fn hotp_of_rfc_secret(counter: Int) -> Text = totp.hotp(to_bytes("12345678901234567890"), counter)

test "a code is accepted once, within one step of clock drift" {
let secret = to_bytes("12345678901234567890")
let moment = 1111111109000
let step = totp.step_of(moment)
assert(totp.verify(secret, "081 804", moment, -1) == .Some(step))
assert(totp.verify(secret, "081804", moment + 30000, -1) == .Some(step))
assert(totp.verify(secret, "081804", moment + 90000, -1) == .None)
assert(totp.verify(secret, "081804", moment, step) == .None)
assert(totp.verify(secret, "81804", moment, -1) == .None)
assert(totp.verify(secret, "abcdef", moment, -1) == .None)
}

test "secrets survive Base32" {
let secret = to_bytes("12345678901234567890")
assert(totp.base32_encode(secret) == "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ")
assert(totp.base32_encode(to_bytes("foobar")) == "MZXW6YTBOI")
assert(totp.base32_decode("gezd gnbv gy3t qojq gezd gnbv gy3t qojq") == .Some(secret))
assert(totp.base32_decode("not base32!") == .None)
assert(totp.grouped("ABCDEFGHIJ") == "ABCD EFGH IJ")
assert(starts_with(totp.provisioning_uri("Tessera site", "admin", "ABCD"), "otpauth://totp/Tessera%20site:admin?secret=ABCD&issuer=Tessera%20site"))
}

fn matrix_text(grid: qr.Grid) -> Text {
var out = ""
for y in range(0, grid.size) {
for x in range(0, grid.size) {
set out += if qr.is_dark(grid, x, y) { "1" } else { "0" }
}
}
out
}

fn matrix_hash(text: Text) -> Text {
let grid = qr.encode(text) else return ""
hex_encode(sha256(to_bytes(matrix_text(grid))))
}

test "QR codes match a reference encoder module for module" {
assert(matrix_hash("hello world") == "ff11d03a5d4c7271b10c332b4fa40be7ba354863ec7af342b03e7358f250d276")
assert(matrix_hash(totp.provisioning_uri("Tessera", "admin", "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ")) == "496baf26c1135aa93aa517eebbab18d50f51d5af4d333c519e541e0f29d64dbf")
let picture = value_or(map_svg(qr.encode("hello")), "")
assert(starts_with(picture, "<svg class='qr' viewBox='0 0 29 29'"))
assert(matrix_hash(repeat("z", 214)) == "")
}

fn map_svg(encoded: Result[qr.Grid, Text]) -> Option[Text] {
let grid = encoded else return .None
.Some(qr.svg(grid, "test"))
}

test "page addresses are checked" {
assert(manage.slug_problem("news-2026") == .None)
assert(manage.slug_problem("") != .None)
assert(manage.slug_problem("News") != .None)
assert(manage.slug_problem("a/b") != .None)
assert(manage.slug_problem("-a") != .None)
assert(manage.slug_problem("admin") != .None)
assert(manage.is_fixed("home") and manage.is_fixed("404"))
assert(manage.clean("a\u{D}\nb\u{D}c") == "a\nb\nc")
}

test "credentials are compared as a whole" {
assert(auth.credentials_ok("admin", "secret", "admin", "secret"))
assert(not auth.credentials_ok("admin", "wrong", "admin", "secret"))
assert(not auth.credentials_ok("other", "secret", "admin", "secret"))
assert(not auth.credentials_ok("", "", "admin", "secret"))
}

test "every block kind of the editor can be rendered" {
for kind in model.kinds() {
let item = model.Block { id: 1, kind: kind.name, heading: "H", body: "B", extra: "E|/e" }
let details = model.Page { slug: "k", title: "K", description: "", nav_label: "", nav_order: 0, published: true }
assert(contains(view.document([:], [], details, [item]), "<section"))
}
}

// ---------- tests for writing content into a database that is already running ----------

note "A private in-memory database with the schema and the content of content.tes in it."
fn prepared() -> Option[Database] uses db, random {
let connection = db_open(":memory:") else return .None
if not ready(connection) {
return .None
}
.Some(connection)
}

note "`prepare` answers with `Result[Unit, Text]`, which cannot be bound to a name; a test wants a plain yes or no."
fn ready(connection: Database) -> Bool uses db, random {
match store.prepare(connection) {
.Ok(_) => true
.Error(_) => false
}
}

fn one_text(connection: Database, sql: Text, params: List[Text]) -> Text uses db {
let rows = db_query(connection, sql, params) else return ""
if length(rows) == 0 {
return ""
}
store.text_of(rows[0], "value")
}

fn body_of(connection: Database, slug: Text, order: Int) -> Text uses db {
one_text(connection, "SELECT body AS value FROM blocks WHERE page_slug = ?1 AND sort_order = ?2", [slug, to_text(order)])
}

fn seed_of(connection: Database, name: Text) -> Text uses db {
one_text(connection, "SELECT value FROM seeded WHERE kind = 'block' AND name = ?1 AND field = 'body'", [name])
}

note "Forgets the fingerprint, so the next `prepare` believes a new version of content.tes was deployed."
fn pretend_new_content(connection: Database) -> Unit uses db {
let _ = db_execute(connection, "DELETE FROM seeded WHERE kind = 'meta'", [])
}

test "an empty database is filled from content" {
let connection = prepared() else return
let found = store.site_pages(connection, "home")
let home = found.page else return assert(false)
assert(home.title == "Home")
assert(length(store.page_blocks(connection, "home")) > 0)
assert(length(found.navigation) > 0)
}

test "preparing twice changes nothing and costs no writes" {
let connection = prepared() else return
let before = one_text(connection, "SELECT COUNT(*) AS value FROM blocks", [])
assert(ready(connection))
assert(one_text(connection, "SELECT COUNT(*) AS value FROM blocks", []) == before)
assert(one_text(connection, "SELECT value FROM seeded WHERE kind = 'meta' AND name = 'content' AND field = 'fingerprint'", []) == store.content_fingerprint())
}

test "a new version of content replaces text nobody touched" {
let connection = prepared() else return
let original = body_of(connection, "home", 1)
assert(original != "")
// Both the page and the seed say something else, as if that had been the text all along.
let _ = db_execute(connection, "UPDATE blocks SET body = 'an older sentence' WHERE page_slug = 'home' AND sort_order = 1", [])
let _ = db_execute(connection, "UPDATE seeded SET value = 'an older sentence' WHERE kind = 'block' AND name = 'home#1' AND field = 'body'", [])
pretend_new_content(connection)
assert(ready(connection))
assert(body_of(connection, "home", 1) == original)
assert(seed_of(connection, "home#1") == original)
}

test "a new version of content leaves text that was edited on the admin pages" {
let connection = prepared() else return
// Only the page changes; the seed still holds what content wrote, so the two differ.
let _ = db_execute(connection, "UPDATE blocks SET body = 'written by the admin' WHERE page_slug = 'home' AND sort_order = 1", [])
pretend_new_content(connection)
assert(ready(connection))
assert(body_of(connection, "home", 1) == "written by the admin")
}

test "a page added on the admin pages survives a new version of content" {
let connection = prepared() else return
let _ = db_execute(connection, "INSERT INTO pages (slug, title, description, nav_label, nav_order, published) VALUES ('news', 'News', '', 'News', 0, 1)", [])
let _ = db_execute(connection, "INSERT INTO blocks (page_slug, sort_order, kind, heading, body, extra) VALUES ('news', 0, 'section', 'Hello', 'Mine', '')", [])
pretend_new_content(connection)
assert(ready(connection))
assert(one_text(connection, "SELECT title AS value FROM pages WHERE slug = 'news'", []) == "News")
assert(body_of(connection, "news", 0) == "Mine")
}

test "whether content may write a field is decided by the seed alone" {
let seeds = ["block|home#1|body": "what content wrote"]
assert(store.content_owns(seeds, "block", "home#1", "body", "what content wrote"))
assert(not store.content_owns(seeds, "block", "home#1", "body", "what the admin wrote"))
assert(store.content_owns(seeds, "block", "home#2", "body", "a block content never wrote"))
}

test "the index at /llms.txt lists the pages that are really in the database" {
let connection = prepared() else return
let site = store.load_settings(connection)
let index = view.llms_index(site, store.listed_pages(connection), "https://tessera-language.com")
assert(starts_with(index, "# Tessera\n"))
assert(contains(index, "(https://tessera-language.com/llms-full.txt)"))
assert(contains(index, "[Home](https://tessera-language.com/)"))
assert(contains(index, "[Why](https://tessera-language.com/why)"))
assert(contains(index, "## Source"))
// The error page is not a page to read, and nothing links to it.
assert(not contains(index, "/404"))
}

fn asking_from(host: Text) -> http.Request {
http.request("GET", "/llms.txt", "") with { headers: ["host": host] }
}

test "the index uses the host the request came in on" {
assert(origin_of(asking_from("example.test")) == "https://example.test")
assert(origin_of(asking_from("localhost:8080")) == "http://localhost:8080")
assert(origin_of(http.request("GET", "/llms.txt", "")) == "")
}
