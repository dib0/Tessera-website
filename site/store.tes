// The SQLite side of the site: the schema and its upgrades, the first-run seeding, and the queries behind the pages.
//
// The database holds the texts and the page structure (settings, pages, blocks), the statistics (hits) and the
// admin state (sessions, admin_state). When the database is empty, `open` fills it from `content`; from then on the
// database is the only source, edited through the admin pages.

import model uses nothing
import content uses nothing
import tracking uses nothing

note "The SQLite file: SITE_DB, relative to TESSERA_FS_ROOT when that is set (the Docker image sets both, so the file lands in the mounted data folder)."
fn database_path() -> Text uses env {
let configured = environment_variable("SITE_DB")
if configured == "" {
return "site.db"
}
configured
}

note "The schema version this code expects; `PRAGMA user_version` holds the version of the file."
fn current_version() -> Int = 2

fn schema_v1() -> List[Text] {
[
"CREATE TABLE IF NOT EXISTS settings (name TEXT PRIMARY KEY, value TEXT NOT NULL)",
"CREATE TABLE IF NOT EXISTS pages (slug TEXT PRIMARY KEY, title TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', nav_label TEXT NOT NULL DEFAULT '', nav_order INTEGER NOT NULL DEFAULT 0, published INTEGER NOT NULL DEFAULT 1)",
"CREATE TABLE IF NOT EXISTS blocks (id INTEGER PRIMARY KEY, page_slug TEXT NOT NULL, sort_order INTEGER NOT NULL, kind TEXT NOT NULL, heading TEXT NOT NULL DEFAULT '', body TEXT NOT NULL DEFAULT '', extra TEXT NOT NULL DEFAULT '', UNIQUE (page_slug, sort_order))",
"CREATE TABLE IF NOT EXISTS hits (id INTEGER PRIMARY KEY, ts INTEGER NOT NULL, day TEXT NOT NULL, path TEXT NOT NULL, status INTEGER NOT NULL, visitor TEXT NOT NULL, referrer TEXT NOT NULL DEFAULT '', agent TEXT NOT NULL DEFAULT '', bot INTEGER NOT NULL DEFAULT 0)",
"CREATE INDEX IF NOT EXISTS hits_by_day ON hits (day)"
]
}

note "Version 2: the login sessions of the admin pages and the admin's own state (session secret, 2FA). Sessions are stored by the SHA-256 of their token, so the database alone does not let anyone in."
fn schema_v2() -> List[Text] {
[
"CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, stage TEXT NOT NULL, created INTEGER NOT NULL, expires INTEGER NOT NULL, attempts INTEGER NOT NULL DEFAULT 0)",
"CREATE TABLE IF NOT EXISTS admin_state (name TEXT PRIMARY KEY, value TEXT NOT NULL)"
]
}

pub fn text_of(row: Map[Text, Text], name: Text) -> Text = value_or(get(row, name), "")

pub fn number_of(row: Map[Text, Text], name: Text) -> Int = value_or(parse_int(text_of(row, name)), 0)

fn first_number(rows: List[Map[Text, Text]], name: Text) -> Int = if length(rows) == 0 { 0 } else { number_of(rows[0], name) }

fn version_of(connection: Database) -> Result[Int, Text] uses db {
let rows = try db_query(connection, "PRAGMA user_version", [])
.Ok(first_number(rows, "user_version"))
}

note "Opens the database and makes sure it is ready. On a new database the tables are created and the initial content is written; an older database is upgraded. Both happen in one transaction, so workers that start at the same moment wait for each other, and the second one finds the work done."
pub fn open() -> Result[Database, Text] uses db, env, random {
let connection = try db_open(database_path())
if try version_of(connection) < current_version() {
try in_transaction(connection, upgrade)
}
.Ok(connection)
}

note "One statement and its parameters, for `run_all`."
pub type Step {
sql: Text
params: List[Text]
}

note "Runs `work` between BEGIN IMMEDIATE and COMMIT, and rolls back when it fails."
pub fn in_transaction(connection: Database, work: fn(Database) -> Result[Unit, Text] uses db, random) -> Result[Unit, Text] uses db, random {
let _ = try db_execute(connection, "BEGIN IMMEDIATE", [])
match work(connection) {
.Ok(_) => {}
.Error(message) => {
let _ = db_execute(connection, "ROLLBACK", [])
return .Error(message)
}
}
let _ = try db_execute(connection, "COMMIT", [])
.Ok(())
}

fn execute_all(connection: Database, steps: List[Step]) -> Result[Unit, Text] uses db {
for item in steps {
let _ = try db_execute(connection, item.sql, item.params)
}
.Ok(())
}

note "Runs the statements in one transaction: all of them, or none."
pub fn run_all(connection: Database, steps: List[Step]) -> Result[Unit, Text] uses db {
let _ = try db_execute(connection, "BEGIN IMMEDIATE", [])
match execute_all(connection, steps) {
.Ok(_) => {}
.Error(message) => {
let _ = db_execute(connection, "ROLLBACK", [])
return .Error(message)
}
}
let _ = try db_execute(connection, "COMMIT", [])
.Ok(())
}

fn upgrade(connection: Database) -> Result[Unit, Text] uses db, random {
let version = try version_of(connection)
if version < 1 {
try execute_all(connection, map(schema_v1(), plain))
let existing = try db_query(connection, "SELECT COUNT(*) AS n FROM pages", [])
if first_number(existing, "n") == 0 {
try seed(connection)
}
let _ = try db_execute(connection, "INSERT OR IGNORE INTO settings (name, value) VALUES ('stats_salt', ?1)", [hex_encode(random_bytes(16))])
}
if version < 2 {
try execute_all(connection, map(schema_v2(), plain))
let _ = try db_execute(connection, "INSERT OR IGNORE INTO admin_state (name, value) VALUES ('session_secret', ?1)", [hex_encode(random_bytes(32))])
}
let _ = try db_execute(connection, "PRAGMA user_version = \(current_version())", [])
.Ok(())
}

fn plain(sql: Text) -> Step = Step { sql: sql, params: [] }

fn seed(connection: Database) -> Result[Unit, Text] uses db {
for entry in content.settings() {
let _ = try db_execute(connection, "INSERT OR IGNORE INTO settings (name, value) VALUES (?1, ?2)", [entry.name, entry.value])
}
for seeded in content.pages() {
let details = seeded.page
let _ = try db_execute(connection, "INSERT OR IGNORE INTO pages (slug, title, description, nav_label, nav_order) VALUES (?1, ?2, ?3, ?4, ?5)", [details.slug, details.title, details.description, details.nav_label, to_text(details.nav_order)])
for index in range(0, length(seeded.blocks)) {
let item = seeded.blocks[index]
let _ = try db_execute(connection, "INSERT OR IGNORE INTO blocks (page_slug, sort_order, kind, heading, body, extra) VALUES (?1, ?2, ?3, ?4, ?5, ?6)", [details.slug, to_text(index), item.kind, item.heading, item.body, item.extra])
}
}
.Ok(())
}

// ---------- reading the site ----------

pub fn page_from(row: Map[Text, Text]) -> model.Page {
model.Page { slug: text_of(row, "slug"), title: text_of(row, "title"), description: text_of(row, "description"), nav_label: text_of(row, "nav_label"), nav_order: number_of(row, "nav_order"), published: text_of(row, "published") != "0" }
}

pub fn block_from(row: Map[Text, Text]) -> model.Block {
model.Block { id: number_of(row, "id"), kind: text_of(row, "kind"), heading: text_of(row, "heading"), body: text_of(row, "body"), extra: text_of(row, "extra") }
}

pub fn load_settings(connection: Database) -> Map[Text, Text] uses db {
var found: Map[Text, Text] = [:]
let rows = db_query(connection, "SELECT name, value FROM settings", []) else return found
for row in rows {
set found = put(found, text_of(row, "name"), text_of(row, "value"))
}
found
}

note "A published page and the menu."
pub type Site {
page: Option[model.Page]
navigation: List[model.Page]
}

fn in_menu(entry: model.Page) -> Bool = entry.nav_order > 0

note "The published page `slug` and the menu (published pages with nav_order > 0, in menu order), read with one query. A page with nav_order 0 is reachable but not listed."
pub fn site_pages(connection: Database, slug: Text) -> Site uses db {
let rows = db_query(connection, "SELECT slug, title, description, nav_label, nav_order, published FROM pages WHERE published = 1 AND (nav_order > 0 OR slug = ?1) ORDER BY nav_order, slug", [slug]) else return Site { page: .None, navigation: [] }
let found = map(rows, page_from)
var current: Option[model.Page] = .None
for entry in found {
if entry.slug == slug {
set current = .Some(entry)
}
}
Site { page: current, navigation: filter(found, in_menu) }
}

pub fn page_blocks(connection: Database, slug: Text) -> List[model.Block] uses db {
let rows = db_query(connection, "SELECT id, kind, heading, body, extra FROM blocks WHERE page_slug = ?1 ORDER BY sort_order", [slug]) else return []
map(rows, block_from)
}

// ---------- statistics ----------

note "Stores one page view. A failure to store is ignored on purpose: a statistics problem must never break a page."
pub fn record_hit(connection: Database, moment: Int, path: Text, status: Int, visitor: Text, referrer: Text, agent: Text, bot: Bool) -> Unit uses db {
let flag = if bot { "1" } else { "0" }
let _ = db_execute(connection, "INSERT INTO hits (ts, day, path, status, visitor, referrer, agent, bot) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)", [to_text(moment), tracking.day_of(moment), path, to_text(status), visitor, referrer, agent, flag])
}
