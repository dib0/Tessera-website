// The initial content of the site. It is written to the database on the first request, when the database is empty;
// after that the database is the only source of texts and page structure, and this module is not read again.
//
// Block kinds (see view.tes): hero, banner, section, cards, steps, list, code, callout, cta.
// In `body` and `heading`: a blank line starts a new paragraph, `code` is code, [label](url) is a link.
// In `extra`: one item per line with fields separated by `|` (buttons, cards, steps), or the caption of a code block.

import model uses nothing

fn make_setting(name: Text, value: Text) -> model.Setting = model.Setting { name: name, value: value }

fn make_block(kind: Text, heading: Text, body: Text, extra: Text) -> model.Block = model.Block { kind: kind, heading: heading, body: body, extra: extra }

fn make_page(slug: Text, title: Text, description: Text, nav_label: Text, nav_order: Int, items: List[model.Block]) -> model.SeedPage {
let details = model.Page { slug: slug, title: title, description: description, nav_label: nav_label, nav_order: nav_order }
model.SeedPage { page: details, blocks: items }
}

fn code_text(rows: List[Text]) -> Text = join(rows, "\n")

pub fn settings() -> List[model.Setting] {
[
make_setting("site_name", "Tessera"),
make_setting("tagline", "A safety-first language for LLM-assisted software"),
make_setting("language", "en"),
make_setting("github_url", "https://github.com/dib0/Tessera-language"),
make_setting("footer_text", "Tessera is open source under the MIT licence and in early development. This site is written in Tessera. It counts page views without cookies and never stores IP addresses."),
make_setting("footer_links", "Tessera on GitHub|https://github.com/dib0/Tessera-language\nSource of this site|https://github.com/dib0/Tessera-website\nStatistics and privacy|/web")
]
}

pub fn pages() -> List[model.SeedPage] {
[page_home(), page_why(), page_language(), page_how(), page_web(), page_get(), page_missing()]
}

// ---------- code samples ----------

fn sample_hello() -> Text {
code_text([
"note \"Keep the age policy in one review point.\"",
"fn is_adult(age: Int) -> Bool = age >= 18",
"",
"fn label(name: Text, age: Int) -> Text {",
"    let category = if is_adult(age) { \"adult\" } else { \"minor\" }",
"    \"\\(category): \\(name)\"",
"}",
"",
"fn main() -> Unit uses io {",
"    print(label(\"Ada\", 20))",
"}"
])
}

fn sample_shapes() -> Text {
code_text([
"enum Shape {",
"    Circle(radius: Int)",
"    Square(side: Int)",
"    Empty",
"}",
"",
"fn area(shape: Shape) -> Int {",
"    match shape {",
"        .Circle(radius) => 3 * radius * radius",
"        .Square(side) => side * side",
"        .Empty => 0",
"    }",
"}"
])
}

fn sample_effects() -> Text {
code_text([
"type Visit {",
"    path: Text",
"    status: Int",
"}",
"",
"// No `uses`: this function is pure.",
"fn describe(visit: Visit) -> Text = \"\\(visit.status) \\(visit.path)\"",
"",
"// `uses db`: this function may talk to the database, and nothing else.",
"fn save(db: Database, visit: Visit) -> Result[Int, Text] uses db {",
"    db_execute(db, \"INSERT INTO hits (path, status) VALUES (?1, ?2)\", [visit.path, to_text(visit.status)])",
"}"
])
}

fn sample_handle() -> Text {
code_text([
"fn handle(request: http.Request) -> http.Response uses db, env, log, random, time {",
"    if request.path == \"/healthz\" {",
"        return http.text(200, \"ok\\n\")",
"    }",
"    if starts_with(request.path, \"/admin\") {",
"        return admin.respond(request)",
"    }",
"    let connection = store.open() else return unavailable()",
"    let site = store.load_settings(connection)",
"    let current = match store.find_page(connection, slug_of(request.path)) {",
"        .Some(found) => found",
"        .None => return missing(connection, site, request)",
"    }",
"    remember(connection, site, request, 200)",
"    let items = store.page_blocks(connection, current.slug)",
"    http.html(200, view.document(site, store.navigation(connection), current, items))",
"}"
])
}

// ---------- pages ----------

fn page_home() -> model.SeedPage {
make_page("home", "Home", "Tessera is a compact, safety-first programming language designed for LLM-assisted software development. Open source, early, and written in itself.", "Home", 0, [
make_block("hero", "A compact, safety-first language for LLM-assisted development.", "Tessera is a programming language that language models can write, review and maintain, and that people can still trust. Small, regular syntax. Effects you can read from a signature. Design rationale kept next to the code.", "View on GitHub|https://github.com/dib0/Tessera-language\nWhy Tessera?|/why\nHow it works|/how"),
make_block("callout", "Early days", "Tessera is an early proof of concept. The syntax and the compiler are not stable yet, and Tessera must not be treated as a security guarantee. We publish early because we want to find out in the open what works.", ""),
make_block("section", "What we are doing", "We are building a programming language for a world in which language models write much of the code. The language, its compiler, its runtime and its standard library live in one open repository, and so does the tooling that measures whether the design choices really help models write correct programs.\n\nThe goal is not code that is pleasant to type. It is software whose behaviour is easy to check: by a model that reviews it, and by a person who cares what the software does rather than how the code looks.", ""),
make_block("cards", "What makes it different", "Six ideas, all aimed at the same thing: programs that are cheap for a model to produce and cheap for a reviewer to verify.", "Written for models, reviewed by humans|The source is plain text with a compact, regular syntax, so a model can produce it reliably and a reviewer can read it quickly.\nSafe by construction|No raw pointers, no unchecked memory access, bounds-checked lists and checked integer arithmetic. Programs compile to safe Rust.\nEffects in the signature|A function that can read files, use the network or query a database says so with `uses`. No `uses` means pure.\nRationale that survives|A `note` records why code exists, and the tooling keeps it. Intent does not get lost in a chat history.\nSelf-hosting|The compiler is written in Tessera itself. The stage 1 compiler is the one that is used today.\nPortable|The aim is Linux, Windows and macOS. Web applications already run as CGI, FastCGI, a built-in HTTP server, or inside nginx and Apache."),
make_block("section", "A first look", "This program has a pure function, a policy that carries a note, and exactly one place where output happens. The `uses io` on `main` is the only effect in the file. Everything else is pure: it cannot print, read a file or open a connection.", ""),
make_block("code", "", sample_hello(), "hello.tes"),
make_block("section", "", "Want the longer argument? Read [Why Tessera](/why). Want the tour? Read [The language](/language). Curious how it all fits together? See [How it works](/how).", ""),
make_block("cta", "Follow the work", "Everything is open source under the MIT licence. Read the design documents, try the examples, or open an issue.", "Tessera on GitHub|https://github.com/dib0/Tessera-language\nGet Tessera|/get")
])
}

fn page_why() -> model.SeedPage {
make_page("why", "Why Tessera?", "Why we are building Tessera: software is increasingly written by language models and reviewed by people, and programming languages were not designed for that.", "Why", 10, [
make_block("banner", "Why Tessera?", "Because the way software gets written is changing faster than the languages we write it in.", ""),
make_block("section", "The problem", "Language models increasingly write code, and people increasingly review it. Most programming languages were designed for the opposite situation: a person typing every character, who benefits from generous syntax, many ways to say the same thing, and conventions that live in people's heads.\n\nFor a model that costs tokens and invites mistakes. For a reviewer it makes the real question hard to answer: what can this code actually do to the world outside the program?", ""),
make_block("section", "Our bet", "If a model writes the code, then what matters to the human is behaviour: what the software does, what it is allowed to touch, and why it was built that way. Tessera is designed around those questions instead of around typing comfort.\n\nThis is for people who care about the functionality of software, not about the code itself.", ""),
make_block("cards", "Design principles", "When two choices are otherwise equal, Tessera picks the one that is higher on this list.", "Safe by construction|Unsafe behaviour must be impossible to write, not merely discouraged.\nReadable at review time|A reviewer, human or model, should see what a function can do from its signature.\nOne way to write it|Each concept has one syntax and one canonical formatting, so diffs stay small and predictable.\nExplicit over implicit|No implicit conversions, no hidden effects, no hidden mutation.\nFamiliar over novel|Where a widely known syntax exists, reuse it, unless it conflicts with the principles above.\nCompact, but not cryptic|Remove boilerplate, not words. Full words over symbols that are not universal."),
make_block("section", "Measured, not assumed", "Whether a syntax really helps a model is an empirical question, so the repository contains a measurement harness. It gives a model programming tasks and a language reference, compiles every answer, feeds compiler errors and failing tests back, and records pass rates, attempts and token cost for each syntax variant.\n\nCompactness is measured with the intended model tokenizer, not by counting characters. Some choices in the language, such as leaving indentation out of the canonical layout, come out of those measurements.", ""),
make_block("section", "Rationale that survives", "A `note` declaration attaches the reason for a piece of code to the code itself, and the tooling preserves it. The compiler can export all notes as JSON, so review bots and documentation tools can read why code exists instead of guessing.", ""),
make_block("callout", "What we do not claim", "Tessera is early. It does not make software correct, and it is not (yet) a security guarantee. The compiler, the generated programs and the runtime still need testing and independent review.", ""),
make_block("cta", "Take the tour", "See what the language looks like, or read the design documents on GitHub.", "The language|/language\nTessera on GitHub|https://github.com/dib0/Tessera-language")
])
}

fn page_language() -> model.SeedPage {
make_page("language", "The language", "A tour of Tessera: types, enums, effects, errors as values, notes and the safety checks of the compiler and runtime.", "Language", 20, [
make_block("banner", "The language", "A small, statically typed, expression-oriented language.", ""),
make_block("section", "Small on purpose", "Tessera has `Int`, `Bool`, `Text`, `Unit`, `List`, `Map`, `Option`, `Result`, `Decimal` and `Bytes`, plus your own records and enums with exhaustive `match`. There are no implicit conversions, no shadowing, no overloading and no methods: one name, one signature.\n\nErrors are values. A function that can fail returns a `Result` or an `Option`, and `try` passes the failure on to the caller.", ""),
make_block("code", "Enums and exhaustive match", sample_shapes(), "shapes.tes"),
make_block("section", "Effects are part of the signature", "A function that touches the outside world must say so with `uses`. The effects include `io`, `fs`, `env`, `time`, `random`, `log`, `db` and `net`, and a function may only call functions whose effects it declares. A function without `uses` is pure: it cannot print, read a file, query a database or open a connection.\n\nDeclaring an effect that is never used is an error too, so a signature cannot quietly overstate what the code does.", ""),
make_block("code", "", sample_effects(), "effects.tes"),
make_block("cards", "Safe by default", "The checks that make a program easier to trust.", "Bounds-checked lists|Indexing outside a list stops the program with a clear runtime error instead of reading arbitrary memory.\nChecked arithmetic|Integer overflow and division by zero are runtime errors, never silent wrap-around.\nStable error codes|Compiler errors such as `E0301` and runtime errors such as `R001` have fixed codes, and usually a `help:` line. That suits people and models alike.\nNo unsafe code|Generated programs carry `#![forbid(unsafe_code)]`, so the Rust compiler rejects unsafe code in them.\nNotes|`note \"...\"` attaches design intent to the next function. Notes never change behaviour, and the tooling exports them.\nExact decimals|`Decimal` is an exact number with nine decimal places, so prices and totals do not drift like floating point."),
make_block("section", "One canonical layout", "Indentation has no meaning in Tessera, and the formatter rewrites source into one canonical layout without it, which saves tokens. The samples on this site are indented only for people. The source of this site itself is in the canonical layout.", ""),
make_block("callout", "Still moving", "The samples run on the current compiler, but the language is not stable yet. Syntax can change as the measurements and the experience come in.", ""),
make_block("cta", "Read the specification", "The language design document is the authoritative description. When the compiler and the document disagree, the document wins.", "Language design on GitHub|https://github.com/dib0/Tessera-language/blob/main/language-design.md\nHow it works|/how")
])
}

fn page_how() -> model.SeedPage {
make_page("how", "How it works", "How Tessera programs are checked, compiled to safe Rust and run, how the compiler bootstraps itself, and how web applications are hosted.", "How it works", 30, [
make_block("banner", "How it works", "From a source file to a native program, and from a compiler to a compiler that compiles itself.", ""),
make_block("steps", "From source to program", "", "Write Tessera|Source files are plain UTF-8 text with the `.tes` extension. Imported modules are found relative to the entry file.\nCheck|The compiler parses the program, resolves names, checks types and checks effects. Errors come with a stable code and a suggested fix.\nGenerate Rust|The checked program is translated to safe Rust, together with a small runtime.\nBuild|`rustc` turns the Rust into a native executable, or into a shared library for a web server. For now you need a Rust toolchain.\nRun|As a command-line program, or, for web applications, as CGI, FastCGI, a built-in HTTP server, or inside nginx or Apache through a native module."),
make_block("section", "A compiler written in Tessera", "The first compiler, stage 0, is written in Rust. It compiled the second one, stage 1, which is written in Tessera itself and is the compiler used today. So that anyone can start the chain with nothing but `rustc`, the repository contains a generated Rust seed of the stage 1 compiler.\n\nThe plan is to continue until the compiler compiles its own source and produces the same compiler again, running the same tests against every stage. That is what self-hosting means, and it is a demanding test for a language that claims to be practical.", ""),
make_block("section", "Safe Rust underneath", "Generated programs carry `#![forbid(unsafe_code)]`. The only `unsafe` code in the runtime is a small adapter that lets a web server load a Tessera program as a shared library.", ""),
make_block("list", "One function, four ways to host it", "A Tessera web application is a program with one function, `handle(request) -> response`. The same source can run as:", "CGI: one process per request, the simplest setup.\nFastCGI: a long-running process behind nginx or Apache.\nHTTP server: `app serve`, behind any reverse proxy, ideal for containers.\nNative module: the program is loaded into the nginx or Apache worker processes, for the lowest overhead."),
make_block("section", "", "This website uses the native nginx module. See [This website](/web) for what that looks like in practice.", ""),
make_block("cta", "Read the hosting guide", "The hosting guide describes every way to run a Tessera web application, with configuration for each server.", "Hosting guide on GitHub|https://github.com/dib0/Tessera-language/blob/main/hosts/README.md\nGet Tessera|/get")
])
}

fn page_web() -> model.SeedPage {
make_page("web", "This website", "This website is a Tessera web application: written in Tessera, served by nginx through the Tessera module, with all texts and the page structure in SQLite.", "This website", 40, [
make_block("banner", "This website", "Written in Tessera, served by nginx, stored in SQLite.", ""),
make_block("section", "Eating our own cooking", "A language for web applications should run a web application, so the site you are reading is one. It is a single Tessera program, `handle(request) -> response`, compiled to a shared library and loaded straight into nginx by the Tessera nginx module.\n\nThe text of every page, the page structure and the navigation are rows in a SQLite database. When the database is empty, the program fills it with the initial content of the site, so a fresh container serves a complete site on its first request.", ""),
make_block("steps", "What happens on a request", "", "nginx accepts the request|The Tessera module hands the method, path, headers and body to the program.\nThe program opens the database|It talks to SQLite through the `db` effect. On first use it creates the tables and seeds the pages.\nThe page is built|The program reads the page and its blocks and renders HTML. All text is escaped, so content cannot inject markup.\nThe visit is counted|A page view is stored with an anonymous visitor id that changes every day.\nThe response is sent|With a strict content security policy, and with framing forbidden."),
make_block("code", "A trimmed excerpt of the router", sample_handle(), "main.tes"),
make_block("section", "Statistics, without tracking", "The site counts page views, so we can see which pages are read and where visitors come from. It sets no cookies and never stores an IP address. A visitor is a hash of a salt that is private to the installation, the day, the address and the browser. It cannot be reversed, and it changes every day, so visitors cannot be followed over time. Of a referrer only the host name is kept.\n\nThe statistics are shown on a password-protected admin page. Its user name and password come from environment variables of the container.", ""),
make_block("section", "Run it yourself", "The site is open source and runs in Docker with one compose file. The database lives in a folder you mount, so it survives restarts and upgrades. See the [website repository](https://github.com/dib0/Tessera-website).", ""),
make_block("callout", "A demonstration", "This site shows what already works. It is not a claim that the nginx module and the runtime are production-mature.", "")
])
}

fn page_get() -> model.SeedPage {
make_page("get", "Get Tessera", "Where to find the Tessera source code, the documentation and the downloads: everything is on GitHub.", "Get Tessera", 50, [
make_block("banner", "Get Tessera", "Source, documentation and downloads live on GitHub.", ""),
make_block("cards", "Where to look", "", "Source code|The compiler, runtime, standard library, the nginx and Apache modules, and the examples.|https://github.com/dib0/Tessera-language\nReleases|Tagged releases, when there are any.|https://github.com/dib0/Tessera-language/releases\nDownload as a zip|The current state of the main branch as a single archive.|https://github.com/dib0/Tessera-language/archive/refs/heads/main.zip\nLanguage design|The authoritative description of the language and the reasoning behind it.|https://github.com/dib0/Tessera-language/blob/main/language-design.md\nHosting web applications|CGI, FastCGI, HTTP, nginx and Apache.|https://github.com/dib0/Tessera-language/blob/main/hosts/README.md\nReport an issue|Found a bug, or have an idea? Open an issue.|https://github.com/dib0/Tessera-language/issues"),
make_block("section", "What you need", "A Rust toolchain from [rustup.rs](https://rustup.rs), because Tessera compiles through Rust. The README of the repository describes how to bootstrap the compiler from the committed seed. The compiler currently runs on Linux; Windows and macOS are goals, not yet supported.", ""),
make_block("section", "Licence", "Tessera is released under the MIT licence. The source of this website is on [GitHub](https://github.com/dib0/Tessera-website) too.", ""),
make_block("callout", "Early software", "Tessera is a proof of concept. Expect changes, and do not rely on it for anything that needs a security guarantee.", "")
])
}

fn page_missing() -> model.SeedPage {
make_page("404", "Page not found", "There is no page at this address.", "", 0, [
make_block("banner", "Page not found", "There is no page at this address. It may have moved, or it never existed.", ""),
make_block("cta", "Find your way back", "", "Back to the home page|/\nTessera on GitHub|https://github.com/dib0/Tessera-language")
])
}
