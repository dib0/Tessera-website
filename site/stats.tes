// The numbers behind the admin page: page views and visitors, read from the `hits` table.
// Bots are counted apart; a visitor is counted once per day (the visitor id changes every day).

import tracking uses nothing

pub type Window {
label: Text
views: Int
visitors: Int
}

pub type Count {
label: Text
views: Int
visitors: Int
}

pub type Report {
today: Window
week: Window
month: Window
everything: Window
bot_views: Int
first_day: Text
days: List[Window]
pages: List[Count]
referrers: List[Count]
browsers: List[Count]
missing: List[Count]
}

fn text_of(row: Map[Text, Text], name: Text) -> Text = value_or(get(row, name), "")

fn number(row: Map[Text, Text], name: Text) -> Int = value_or(parse_int(text_of(row, name)), 0)

fn window(connection: Database, label: Text, since: Text) -> Window uses db {
let empty = Window { label: label, views: 0, visitors: 0 }
let rows = db_query(connection, "SELECT COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE bot = 0 AND day >= ?1", [since]) else return empty
if length(rows) == 0 {
return empty
}
Window { label: label, views: number(rows[0], "views"), visitors: number(rows[0], "visitors") }
}

note "One bar per day, oldest first, with zeros for days without visits."
fn daily(connection: Database, moment: Int, count: Int) -> List[Window] uses db {
let rows = db_query(connection, "SELECT day, COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE bot = 0 AND day >= ?1 GROUP BY day", [tracking.days_before(moment, count - 1)]) else return []
var found: Map[Text, Window] = [:]
for row in rows {
let day = text_of(row, "day")
set found = put(found, day, Window { label: day, views: number(row, "views"), visitors: number(row, "visitors") })
}
var series: List[Window] = []
for offset in range(0, count) {
let day = tracking.days_before(moment, count - 1 - offset)
set series += [value_or(get(found, day), Window { label: day, views: 0, visitors: 0 })]
}
series
}

note "The SQL must return the columns label, views and visitors."
fn counts(connection: Database, sql: Text, since: Text) -> List[Count] uses db {
let rows = db_query(connection, sql, [since]) else return []
var out: List[Count] = []
for row in rows {
set out += [Count { label: text_of(row, "label"), views: number(row, "views"), visitors: number(row, "visitors") }]
}
out
}

fn single_number(connection: Database, sql: Text, name: Text) -> Int uses db {
let rows = db_query(connection, sql, []) else return 0
if length(rows) == 0 {
return 0
}
number(rows[0], name)
}

pub fn report(connection: Database, moment: Int) -> Report uses db {
let month_start = tracking.days_before(moment, 29)
let first_rows = db_query(connection, "SELECT MIN(day) AS first_day FROM hits", []) else return empty_report()
let first_day = if length(first_rows) == 0 { "" } else { text_of(first_rows[0], "first_day") }
let today = window(connection, "Today", tracking.day_of(moment))
let week = window(connection, "Last 7 days", tracking.days_before(moment, 6))
let month = window(connection, "Last 30 days", month_start)
let everything = window(connection, "All time", "0000-00-00")
let bot_views = single_number(connection, "SELECT COUNT(*) AS n FROM hits WHERE bot = 1", "n")
let days = daily(connection, moment, 14)
let pages = counts(connection, "SELECT path AS label, COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE bot = 0 AND status = 200 AND day >= ?1 GROUP BY path ORDER BY views DESC, path LIMIT 10", month_start)
let referrers = counts(connection, "SELECT referrer AS label, COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE bot = 0 AND referrer <> '' AND day >= ?1 GROUP BY referrer ORDER BY views DESC, referrer LIMIT 10", month_start)
let browsers = counts(connection, "SELECT agent AS label, COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE bot = 0 AND day >= ?1 GROUP BY agent ORDER BY views DESC, agent LIMIT 10", month_start)
let missing = counts(connection, "SELECT path AS label, COUNT(*) AS views, COUNT(DISTINCT visitor) AS visitors FROM hits WHERE status = 404 AND day >= ?1 GROUP BY path ORDER BY views DESC, path LIMIT 10", month_start)
Report { today: today, week: week, month: month, everything: everything, bot_views: bot_views, first_day: first_day, days: days, pages: pages, referrers: referrers, browsers: browsers, missing: missing }
}

fn empty_report() -> Report {
let zero = Window { label: "", views: 0, visitors: 0 }
Report { today: zero, week: zero, month: zero, everything: zero, bot_views: 0, first_day: "", days: [], pages: [], referrers: [], browsers: [], missing: [] }
}
