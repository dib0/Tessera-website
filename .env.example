# Copy to .env (never commit .env). docker compose reads it automatically.

# The admin account of /admin. Use a long random password, and turn on two-factor authentication on /admin/account.
# Put the site behind HTTPS when it is public: the session cookie is only sent over HTTPS (or to localhost).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional
# PORT=8080
# DATA_DIR=./data
# TESSERA_SRC=../Tessera-language
# IMAGE=ghcr.io/dib0/tessera-website:latest
