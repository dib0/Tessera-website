# Copy to .env (never commit .env). docker compose reads it automatically.

# Credentials of the admin page at /admin (HTTP Basic authentication). Use a long random password,
# and put the site behind HTTPS when it is public, because Basic authentication sends the password on every request.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional
# PORT=8080
# DATA_DIR=./data
# TESSERA_SRC=../Tessera-language
# IMAGE=ghcr.io/dib0/tessera-website:latest
